{
  "manifest_version": 3,
  "name": "Torval",
  "version": "1.1.0",
  "description": "Hold Shift and hover any word (Japanese, Italian or Spanish) to see what it means.",
  "author": "Jacob Gerritz",
  "homepage_url": "https://jacobgerritz.github.io/Torval/",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "torval@jacobgerritz",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "declarativeNetRequest",
    "downloads",
    "scripting",
    "offscreen"
  ],
  "optional_permissions": [
    "tabCapture"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "captions",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "sw.js",
    "scripts": [
      "log.js",
      "track.js",
      "japanese.js",
      "scan.js",
      "italian.js",
      "italian-scan.js",
      "spanish.js",
      "spanish-scan.js",
      "english.js",
      "english-scan.js",
      "lang.js",
      "deinflect.js",
      "deinflect-latin.js",
      "deinflect-it.js",
      "deinflect-es.js",
      "deinflect-en.js",
      "lookup-common.js",
      "lookup.js",
      "lookup-latin.js",
      "anki.js",
      "pitch.js",
      "stress.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "japanese.js",
        "scan.js",
        "italian.js",
        "italian-scan.js",
        "spanish.js",
        "spanish-scan.js",
        "english.js",
        "english-scan.js",
        "lang.js",
        "log.js",
        "track.js",
        "keys.js",
        "look.js",
        "stress.js",
        "article.js",
        "lookup-common.js",
        "subtitles.js",
        "video.js",
        "bar.js",
        "highlight.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Torval",
    "default_popup": "switch.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://assets.languagepod101.com/*",
    "https://upload.wikimedia.org/*",
    "https://www.youtube.com/*",
    "*://*.netflix.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
