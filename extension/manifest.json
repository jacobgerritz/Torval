{
  "manifest_version": 3,
  "name": "Torval",
  "version": "0.1.0",
  "description": "Hold Shift and hover any word (Japanese, Italian or Spanish) to see what it means.",
  "author": "Jacob Gerritz",
  "homepage_url": "https://github.com/jacobgerritz/torval",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lll@jacobgerritz",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "scripting"
  ],
  "background": {
    "scripts": [
      "japanese.js",
      "scan.js",
      "italian.js",
      "italian-scan.js",
      "spanish.js",
      "spanish-scan.js",
      "lang.js",
      "deinflect.js",
      "deinflect-latin.js",
      "deinflect-it.js",
      "deinflect-es.js",
      "lookup-common.js",
      "lookup.js",
      "lookup-latin.js",
      "anki.js",
      "pitch.js",
      "stress.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "run_at": "document_start"
    },

    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "japanese.js",
        "scan.js",
        "italian.js",
        "italian-scan.js",
        "spanish.js",
        "spanish-scan.js",
        "lang.js",
        "stress.js",
        "subtitles.js",
        "video.js",
        "bar.js",
        "highlight.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Torval",
    "default_popup": "switch.html",
    "default_icon": "icon.svg"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://assets.languagepod101.com/*",
    "https://www.youtube.com/*",
    "*://*.netflix.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
