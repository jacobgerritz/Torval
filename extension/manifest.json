{
  "manifest_version": 3,
  "name": "LLL",
  "version": "0.1.0",
  "description": "Hold Shift and hover any Japanese word to see what it means.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lll@jacobgerritz",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "downloads"
  ],
  "background": {
    "scripts": [
      "japanese.js",
      "deinflect.js",
      "lookup.js",
      "anki.js",
      "pitch.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "netflix.js"
      ],
      "run_at": "document_start"
    },

    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "japanese.js",
        "subtitles.js",
        "video.js",
        "bar.js",
        "highlight.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "LLL",
    "default_popup": "switch.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://assets.languagepod101.com/*",
    "https://www.youtube.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.nflxso.net/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
