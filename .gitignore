# Raw downloads (JMdict, Kanjium accents), fetched by the tools/build-* scripts
data/

# Built dictionary and pitch data, regenerate with:
#   node tools/build-dict.mjs && node tools/build-pitch.mjs
extension/data/

# Built Italian dictionary data, regenerate with:
#   node tools/build-dict-it.mjs
extension/data-it/

# Built Spanish dictionary data, regenerate with:
#   node tools/build-dict-es.mjs
extension/data-es/

node_modules/
*.log

# A third-party extension's source, kept locally for reference only, never
# to be committed or redistributed as part of this repository.
Seek Subtitles for YouTube/

# Release packages, built with:
#   node tools/package.mjs
dist/

# Python bytecode from the Anki add-on
__pycache__/

# Anki writes this into an installed add-on and owns it
anki/*/meta.json

# The packaged add-on, built with:
#   cd anki/known_words_export && zip -qXr ../known-words-export.ankiaddon . -x "meta.json" "__pycache__/*"
*.ankiaddon

# Editor/tool scratch, never part of the project
.claude/
